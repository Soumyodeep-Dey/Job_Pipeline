POSTGRES_USER=job_pipeline
POSTGRES_PASSWORD=local_password
POSTGRES_DB=job_pipeline
POSTGRES_PORT=5432
API_PORT=8000
# Local Python only; Compose uses its internal database hostname automatically.
DATABASE_URL=postgresql+psycopg://job_pipeline:local_password@localhost:5432/job_pipeline

# Run python scripts/setup_local.py to generate a private sign-in password.
AUTH_USERNAME=owner
AUTH_PASSWORD=
ALLOWED_HOSTS=localhost,127.0.0.1
DEPLOYMENT_MODE=local
# Production only: HTTPS origin without trailing slash.
PUBLIC_ORIGIN=
# Optional: SHA-256 ID from /resumes?include_archived=true; limits new matching to one master.
MASTER_RESUME_ID=
